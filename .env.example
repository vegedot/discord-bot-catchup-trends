# Claude API キー（必須）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Discord Bot トークン（必須）
# https://discord.com/developers/applications で取得
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord フォーラムチャンネル ID（必須）
# 取得方法: Discord の開発者モードをオン → チャンネルを右クリック → ID をコピー
DISCORD_FORUM_CHANNEL_ID=your_discord_forum_channel_id_here

# ドライラン（省略時は false）
# true にすると Discord への投稿を行わず、投稿内容をコンソールに出力する
DRY_RUN=false
